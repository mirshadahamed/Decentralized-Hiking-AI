# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local environment and secret material
.env
.env.*
!.env.example
*.keystore
*.jks
key.properties
google-services.json
GoogleService-Info.plist

# Platform-generated transient files
ios/Flutter/ephemeral/
macos/Flutter/ephemeral/

# Component 4 (ML): downloaded/generated data and model checkpoints stay local
ml/component_4/data/*
!ml/component_4/data/.gitkeep
ml/component_4/results/**/*.pt
ml/component_4/results/**/predictions_*.npz
ml/component_4/results/*_quick/
__pycache__/
.pytest_cache/

# Component 2: source photos, generated machine-specific YAML and model outputs
sajana/data/raw/
sajana/data/processed/**/images/
sajana/data/processed/**/orientation_review/
sajana/data/processed/**/data.yaml
sajana/results/**/*.jpg
sajana/results/**/*.png
sajana/results/**/*.pt
sajana/runs/

# ORFD semantic label PNGs are generated from retained source masks
sajana/data/processed/orfd_path_seg*/masks/

    },
    {
      "source": "ORFD",
      "role": "separate_auxiliary_vehicle_freespace_segmentation",
      "mapping": [
        {
          "source_rule": "RGB_blue_channel > 200",
          "auxiliary_class_id": 1,
          "auxiliary_name": "vehicle_freespace_proxy",
          "final_target_key": null
        },
        {
          "source_rule": "RGB_blue_channel <= 200",
          "auxiliary_class_id": 0,
          "auxiliary_name": "non_freespace",
          "final_target_key": null
        }
      ],
      "forbidden_inferences": [
        "non_freespace_is_damage",
        "freespace_is_hiking_safety",
        "freespace_provides_erosion_or_root_masks"
      ],
      "preserve_source_splits": true,
      "report": "sajana/results/orfd_preprocessing/local_readiness.json"
    },
    {
      "source": "pLitter_Mawanella_supplied_CSV",
      "role": "geospatial_observation_mapping_only",
      "source_columns": [
        "lon",
        "lat",
        "plastic_c",
        "bin_c"
      ],
      "image_training_labels": false,
      "target_class_mapping": [],
      "derive_unique_physical_item_counts_from_repeated_observations": false
    },
    {
      "source": "pLitterStreet_actual_release_if_acquired",
      "role": "supplementary_detection_domain_study",
      "mapping_status": "audit_actual_released_category_catalog_and_annotation_geometry_first",
      "source_category_ids_invented": false,
      "box_to_segmentation_ground_truth_allowed": false,
      "segmentation_subset_requires_reviewed_polygons": true
    },
    {
      "source": "WildScenes_or_RUGD_if_acquired",
      "role": "separate_natural_scene_context",
      "mapping_status": "verify_actual_catalog_ids_and_names_first",
      "potential_context_classes_from_master_document": [
        "dirt",
        "mud",
        "vegetation",
        "log",
        "rock"
      ],
      "final_hazard_class_mapping": [],
      "forbidden_inferences": [
        "dirt_is_erosion",
        "vegetation_is_exposed_roots",

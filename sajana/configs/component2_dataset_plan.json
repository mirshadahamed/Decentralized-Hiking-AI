    },
    {
      "source": "TACO_unofficial_validated",
      "role": "optional_litter_train_only_pool",
      "source_annotation": "COCO_instance_polygons",
      "mapping": [
        {
          "source_category_id": 0,
          "source_name": "litter",
          "target_key": "litter"
        }
      ],
      "requires": [
        "verified_photo_label_correspondence",
        "cross_source_duplicate_audit",
        "all_unreviewed_non_litter_classes_remain_unknown"
      ],
      "report": "sajana/results/taco_preprocessing/unofficial_labels_audit.json"
    },
    {
      "source": "MJU_Waste",

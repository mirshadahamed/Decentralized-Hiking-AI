  "split_policy": {
    "local_initial_split": "unassigned",
    "prefer_holdout_unit": [
      "site_id",
      "route_id"
    ],
    "fallback_holdout_unit": [
      "session_id",
      "sequence_id"
    ],
    "must_not_cross_splits": [
      "same_capture_session_or_sequence",
      "near_duplicate_group_id",
      "connected_group_membership"
    ],
    "if_sites_shared_between_splits": "Report weaker independence explicitly.",
    "random_neighbor_frame_split_allowed": false,
    "final_local_test_for_threshold_tuning": false,
    "augmentation_scope": "train_only_after_group_assignment",
    "public_holdouts": "Preserve existing TACO official held-out batches and every source benchmark membership."
  },
  "ordered_stages": [
    {
      "order": 1,
      "name": "source_inventory_and_taxonomy",
      "acceptance": [
        "original_source_hashes",
        "source_ids",
        "source_version_and_licence",
        "task_role"
      ]
    },
    {
      "order": 2,
      "name": "verify_official_taco_and_mju",
      "acceptance": [
        "decoded_pairs",
        "source_label_correspondence",
        "duplicate_audit",
        "fixed_taco_holdouts"
      ]
    },
    {
      "order": 3,
      "name": "optional_unofficial_taco_recovery",
      "acceptance": [
        "matching_photos",
        "explicit_unrecoverable_records",
        "no_holdout_duplicate_leakage"
      ]
    },
    {
      "order": 4,
      "name": "complete_available_orfd_release",
      "acceptance": [
        "lossless_mask_conversion",
        "rgb_mask_geometry",
        "source_hashes_crc",
        "honest_mirror_vs_published_coverage"
      ]
    },
    {
      "order": 5,
      "name": "audit_relevant_public_support",
      "acceptance": [
        "representative_visual_sample",
        "actual_source_class_mapping",
        "no_invented_segmentation_or_damage_labels"
      ]
    },
    {
      "order": 6,
      "name": "real_local_collection_and_annotation",
      "acceptance": [
        "real_images",
        "coverage_states",
        "reviewed_polygons",
        "uncertainty_adjudication",
        "annotation_agreement"
      ]
    },
    {
      "order": 7,
      "name": "grouped_holdouts_and_version_freeze",
      "acceptance": [
        "group_leakage_checks",
        "untouched_local_test",
        "class_counts_and_coverage_report",
        "versioned_data_card"
      ]
    },
    {
      "order": 8,
      "name": "task_export_and_model_input_gate",
      "acceptance": [
        "task_specific_readiness",
        "complete_joint_labels_or_missing_label_aware_training",
        "no_training_started_by_preprocessing"
      ]
    }
  ],
  "readiness_gates": {
    "litter_baseline": [
      "complete_verified_selected_image_label_pairs",
      "unchanged_taco_holdouts",
      "valid_binary_litter_polygons",
      "cross_split_duplicate_check"
    ],
    "auxiliary_path_baseline": [
      "verified_selected_rgb_mask_pairs",
      "preserved_source_splits",
      "explicit_release_coverage",
      "vehicle_proxy_limitation_recorded"
    ],
    "concurrent_component": [
      "genuine_damage_and_selected_obstruction_ground_truth",
      "reviewed_local_trail_context",
      "valid_per_class_coverage",
      "grouped_local_holdouts",
      "compatible_joint_export_or_missing_label_aware_loader"
    ],
    "optional_source_failures_block_verified_litter_baseline": false
  },
  "live_status_references": [
    "sajana/results/component2_preprocessing/status.json",
    "sajana/results/taco_preprocessing/supplied_preprocessing_status.json",
    "sajana/results/training_readiness_recheck.json"
  ],
  "training_roadmap": "sajana/docs/COMPONENT2_TRAINING_ROADMAP.md",
  "training_plan": "sajana/configs/component2_training_plan.json",
  "requested_photo_outputs": {
    "litter": "independent garbage detection/segmentation",
    "obstruction": "reviewed object relation to visible route corridor",
    "marked_trail_alternative": "requires reviewed located blockage and versioned permitted trail graph",
    "visible_bypass": "requires reviewed corridor, surface, clearance and return to marked trail",
    "missing_evidence_state": "unable_to_assess"
  }
}

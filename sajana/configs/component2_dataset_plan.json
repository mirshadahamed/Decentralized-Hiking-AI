        {
          "source_category_id": 0,
          "source_name": "Rubbish",
          "target_key": "litter"
        }
      ],
      "negative_empty_labels_cover": [
        "litter"
      ],
      "unknown_keys": [
        "erosion_washout",
        "exposed_roots",
        "fallen_tree_major_branch",

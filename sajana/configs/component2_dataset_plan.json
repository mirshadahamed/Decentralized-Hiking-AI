{
  "schema_version": 1,
  "plan_version": "2026-10-20",
  "component": "Ground-Level Vision for Concurrent Litter Detection & Trail Damage Segmentation",
  "purpose": "Dataset and annotation planning; not a model training configuration or a readiness certificate.",
  "reference": {
    "master_document": "Component 2 Research Component Master Document, October 2026, pages 4-11",
    "local_plan": "sajana/docs/COMPONENT2_DATASET_PLAN.md"
  },
  "local_data": {
    "user_confirmed_no_annotated_local_trails": true,
    "confirmation_date": "2026-10-20",
    "workspace": "sajana/data/local_trails",
    "templates_contain_sample_records": false,
    "full_component_training_ready": false,
    "collection_targets_only": {
      "pilot_images": [
        50,
        100
      ],
      "overall_images": [
        1000,
        2000
      ]
    }
  },
  "taxonomy": {
    "status": "working_annotation_keys_pending_source_sample_audit_and_scope_review",
    "current_litter_export": {
      "task": "instance_segmentation",
      "names": {
        "0": "litter"
      }
    },
    "concurrent_numeric_export_ids_assigned": false,
    "classes": [
      {
        "key": "litter",
        "scope": "core",
        "geometry": "instance_polygon",
        "meaning": "Visible artificial waste; distinguish individual items from mixed piles.",
        "exclude": [
          "natural leaves",
          "flowers",
          "ordinary branches",
          "ambiguous unreviewed objects"
        ]
      },
      {
        "key": "erosion_washout",
        "scope": "core",
        "geometry": "region_polygon",
        "meaning": "Visible displaced/lost trail surface, rills/gullies or washout.",
        "exclude": [
          "generic dirt",
          "mud alone",
          "color change alone"
        ]
      },
      {
        "key": "exposed_roots",
        "scope": "core",
        "geometry": "region_polygon",
        "meaning": "Visible exposed root network on or at trail.",
        "exclude": [
          "generic vegetation",
          "inferred hidden roots"
        ],
        "severity_from_presence": false
      },
      {
        "key": "fallen_tree_major_branch",
        "scope": "requested_obstruction_expansion_pending_reviewed_labels",
        "geometry": "instance_polygon",
        "meaning": "Visible fallen trunk or large branch; record route relation independently.",
        "exclude": [
          "upright trees",
          "small twigs"
        ],
        "blockage_from_presence": false
      },
      {
        "key": "rock_boulder_rockfall",
        "scope": "requested_obstruction_expansion_pending_reviewed_labels",
        "geometry": "instance_or_region_polygon",
        "meaning": "Substantial visible rock/boulder or rockfall region.",
        "exclude": [
          "ordinary small gravel"
        ],
        "cause_from_appearance": false,
        "blockage_from_presence": false
      },
      {
        "key": "landslide_rubble_debris",
        "scope": "requested_obstruction_expansion_pending_reviewed_labels",
        "geometry": "region_polygon",
        "meaning": "Visible rubble/debris region; origin unknown unless evidenced.",
        "exclude": [
          "all muddy or rocky surfaces"
        ],
        "default_origin": "unknown"
      },
      {
        "key": "traversable_trail",
        "scope": "route_context",
        "geometry": "semantic_region_polygon",
        "meaning": "Visible usable trail/access-route surface under a versioned local rule.",
        "exclude": [
          "all vehicle freespace",
          "all soil",
          "imagined occluded trail pixels"
        ]
      }
    ],
    "litter_subtype_attribute": {
      "values": [
        "rigid_plastic",
        "soft_plastic_paper",
        "metal_glass",
        "mixed_waste_pile",
        "other",
        "unknown"
      ],
      "unknown_default": true,
      "derive_from_binary_class_only": false
    },
    "passability_attribute": {
      "values": [
        "clear",
        "partly_restricted",
        "substantially_blocked",
        "uncertain"
      ],
      "level": "reviewed_image_or_route",
      "requires_visible_evidence_and_review": true,
      "unreviewed_has_label": false,
      "automatic_orfd_labels_allowed": false
    },
    "route_overlap_policy": {
      "reference_geometry_must_be_defined_before_evaluation": true,
      "visible_usable_surface_equals_route_corridor": false,
      "hidden_route_ground_truth_may_be_invented": false,
      "separate_corridor_annotation_requires_review": true
    }
  },
  "coverage_policy": {
    "missing_coverage_row_means": "unreviewed",
    "states": {
      "unreviewed": {
        "positive_supervision": false,
        "negative_supervision": false,
        "meaning": "No exhaustive class review."
      },
      "positive_partial": {
        "positive_supervision": true,
        "negative_supervision": false,
        "meaning": "Known positives exist; other instances or regions may be missing."
      },
      "positive_complete": {
        "positive_supervision": true,
        "negative_supervision": true,
        "minimum_positive_count": 1,
        "meaning": "All visible class instances/regions reviewed and annotated."
      },
      "negative_reviewed": {
        "positive_supervision": false,
        "negative_supervision": true,
        "positive_count": 0,
        "meaning": "Class explicitly reviewed and absent."
      },
      "uncertain": {
        "positive_supervision": false,
        "negative_supervision": false,
        "meaning": "Await adjudication or use explicit ignored region/class support."
      }
    },
    "empty_yolo_file_is_full_scene_negative_only_if": "Every exported target class has negative_reviewed coverage.",
    "positive_partial_requires_class_region_ignore_support": true,
    "standard_yolo_txt_encodes_coverage_states": false,
    "naive_merge_of_incomplete_task_labels_allowed": false,
    "supported_planning_options": [
      "staged_task_specific_training",
      "fully_reviewed_joint_subset",
      "implemented_and_tested_missing_label_aware_trainer"
    ],
    "missing_label_aware_trainer_implemented_by_this_plan": false
  },
